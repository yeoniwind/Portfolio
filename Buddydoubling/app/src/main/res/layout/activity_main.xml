<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8F8F8">

    <TextView
        android:id="@+id/tvSetYourRoutine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="set your routine"
        android:textColor="#5A78C5"
        android:textSize="14sp"
        android:layout_gravity="center_horizontal" />

    <TextView
        android:id="@+id/tvRoutineTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="루틴 설정"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvDefaultRoutine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="기본루틴✔"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <!-- RecyclerView for the routine list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewRoutine"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <!-- Custom line or progress bar graphic (could be customized further) -->


    <TextView
        android:id="@+id/tvCustomRoutine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="나만의 루틴 만들기✔"
        android:textSize="18sp"
        android:layout_gravity="center_horizontal" />

</LinearLayout>
